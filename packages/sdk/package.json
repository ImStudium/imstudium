{
  "name": "@imstudium/sdk",
  "version": "0.2.0",
  "description": "ImStudium Stud.IP JSON:API client, auth, sync, and Studium workspace builder",
  "license": "MIT",
  "type": "module",
  "author": "Patrick Schröppel",
  "repository": {
    "type": "git",
    "url": "https://github.com/ImStudium/imstudium.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/ImStudium/imstudium#readme",
  "bugs": {
    "url": "https://github.com/ImStudium/imstudium/issues"
  },
  "keywords": [
    "imstudium",
    "studip",
    "studium",
    "jsonapi"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build && bun run typecheck"
  },
  "imsicheren": {
    "namespace": "imstudium",
    "kinds": [
      "generic_json",
      "oauth_token"
    ]
  },
  "dependencies": {
    "@firecrawl/anydoc": "^0.1.9",
    "@firecrawl/pdf-inspector": "^1.14.2",
    "keytar": "^7.9.0",
    "playwright": "^1.52.0"
  },
  "peerDependencies": {
    "@imsicheren/sdk": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@imsicheren/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsup": "^8.5.0",
    "typescript": "^6.0.2",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
