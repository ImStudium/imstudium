{
  "name": "digicampus-sdk",
  "version": "0.1.0",
  "description": "DigiCampus Stud.IP JSON:API client, auth, sync, and Studium workspace builder",
  "license": "MIT",
  "type": "module",
  "author": "Patrick Schröppel",
  "repository": {
    "type": "git",
    "url": "https://github.com/paddy-shrp/digicampus.git"
  },
  "homepage": "https://github.com/paddy-shrp/digicampus#readme",
  "bugs": {
    "url": "https://github.com/paddy-shrp/digicampus/issues"
  },
  "keywords": [
    "digicampus",
    "studip",
    "studium",
    "jsonapi"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "dependencies": {
    "keytar": "^7.9.0",
    "playwright": "^1.52.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
