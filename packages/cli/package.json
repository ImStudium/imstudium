{
  "name": "@imstudium/cli",
  "version": "0.2.0",
  "description": "ImStudium CLI — study workspace from Stud.IP",
  "license": "MIT",
  "type": "module",
  "author": "Patrick Schröppel",
  "repository": {
    "type": "git",
    "url": "https://github.com/ImStudium/imstudium.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/ImStudium/imstudium#readme",
  "bugs": {
    "url": "https://github.com/ImStudium/imstudium/issues"
  },
  "keywords": [
    "imstudium",
    "studip",
    "studium",
    "mcp",
    "cursor",
    "claude",
    "codex",
    "windsurf",
    "opencode"
  ],
  "bin": {
    "imstudium": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "mcp.json"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build && bun run typecheck"
  },
  "dependencies": {
    "@imstudium/contract": "^0.2.0",
    "@imstudium/sdk": "^0.2.0",
    "commander": "^13.1.0",
    "playwright": "^1.52.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^6.0.2",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
