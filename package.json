{
  "name": "digicampus-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "DigiCampus Studium OS — extraction harness + study workspace for Stud.IP",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/paddy-shrp/digicampus.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "test": "vitest run",
    "validate": "turbo run typecheck build && vitest run",
    "install:dev": "bash scripts/install-dev.sh"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.9"
  },
  "packageManager": "bun@1.2.0",
  "engines": {
    "bun": ">=1.2"
  }
}
