{
  "name": "@imstudium/contract",
  "version": "0.2.0",
  "description": "ImStudium wire contract — zod schemas for every CLI --json output, the error table and the imstudium/source/v1 feed",
  "license": "MIT",
  "type": "module",
  "author": "Patrick Schröppel",
  "repository": {
    "type": "git",
    "url": "https://github.com/ImStudium/imstudium.git",
    "directory": "packages/contract"
  },
  "homepage": "https://github.com/ImStudium/imstudium#readme",
  "bugs": {
    "url": "https://github.com/ImStudium/imstudium/issues"
  },
  "keywords": [
    "imstudium",
    "studip",
    "contract",
    "zod",
    "json-schema"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build && bun run typecheck"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsup": "^8.5.0",
    "typescript": "^6.0.2",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
