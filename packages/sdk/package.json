{
  "name": "@imstudium/sdk",
  "version": "0.4.1",
  "description": "ImStudium for Stud.IP: the imstudium CLI, the imstudium-mcp server and the SDK in one package",
  "license": "MIT",
  "type": "module",
  "author": "Patrick Schröppel",
  "repository": {
    "type": "git",
    "url": "https://github.com/ImStudium/imstudium.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/ImStudium/imstudium#readme",
  "bugs": {
    "url": "https://github.com/ImStudium/imstudium/issues"
  },
  "keywords": [
    "imstudium",
    "studip",
    "stud.ip",
    "studium",
    "jsonapi",
    "cli",
    "mcp",
    "claude",
    "cursor",
    "codex"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "csl"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "echo \"Publish the assembled package: bun scripts/assemble-sdk.ts, then release.yml\" >&2 && exit 1"
  },
  "imsicheren": {
    "namespace": "imstudium",
    "kinds": [
      "generic_json",
      "oauth_token"
    ]
  },
  "dependencies": {
    "@firecrawl/anydoc": "^0.2.4",
    "@firecrawl/pdf-inspector": "^1.25.2",
    "citeproc": "^2.4.63",
    "katex": "^0.19.1",
    "keytar": "^7.9.0",
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@imstudium/contract": "^0.4.1",
    "@types/node": "^24",
    "tsup": "^8.5.0",
    "typescript": "^6.0.2",
    "@typescript/native": "npm:typescript@7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
