    "validate": "pnpm typecheck && pnpm build && pnpm test",
    "test:e2e": "bash scripts/test-e2e.sh"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
