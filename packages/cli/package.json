{
  "name": "@imstudium/cli",
  "version": "0.4.1",
  "private": true,
  "description": "ImStudium CLI — study workspace from Stud.IP",
  "license": "MIT",
  "type": "module",
  "author": "Patrick Schröppel",
  "repository": {
    "type": "git",
    "url": "https://github.com/ImStudium/imstudium.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/ImStudium/imstudium#readme",
  "bugs": {
    "url": "https://github.com/ImStudium/imstudium/issues"
  },
  "keywords": [
    "imstudium",
    "studip",
    "studium",
    "mcp",
    "cursor",
    "claude",
    "codex",
    "windsurf",
    "opencode"
  ],
  "bin": {
    "imstudium": "dist/cli.js"
  },
  "exports": {
    "./program": {
      "types": "./dist/program.d.ts",
      "import": "./dist/program.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "mcp.json"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@imstudium/contract": "^0.4.1",
    "@imstudium/sdk": "^0.4.1",
    "commander": "^13.1.0",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "@typescript/native": "npm:typescript@7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
